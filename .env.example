# Variables que lee app/build.gradle para firmar con tu llave fija (opcional).
# En GitHub Actions salen de los secretos del repositorio; nunca subas valores reales.
# Para compilar en tu computadora, expórtalas en la terminal antes de ./gradlew assembleRelease.
KEYSTORE_FILE=/ruta/fuera/del/repo/inicio-auto.jks
KEYSTORE_PASSWORD=cambia-esto
KEY_ALIAS=inicio-auto
KEY_PASSWORD=cambia-esto
