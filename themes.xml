<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="StatusText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text3</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/text3</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="RoundButton">
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text</item>
        <item name="android:background">@drawable/bg_circle_dark</item>
    </style>
</resources>
