<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de "vidrio": capa translúcida con borde fino. Sin desenfoque (Android 10 no lo soporta). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="@color/glass_top" android:endColor="@color/glass_bottom"/>
    <stroke android:width="1dp" android:color="@color/line"/>
    <corners android:radius="28dp"/>
</shape>
