<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
    <gradient android:angle="270" android:startColor="@color/glass_pressed" android:endColor="@color/glass_top"/>
    <stroke android:width="1dp" android:color="@color/line"/>
    
</shape>
    </item>
    <item>
        <shape android:shape="oval">
    <gradient android:angle="270" android:startColor="@color/glass_top" android:endColor="@color/glass_bottom"/>
    <stroke android:width="1dp" android:color="@color/line"/>
    
</shape>
    </item>
</selector>
