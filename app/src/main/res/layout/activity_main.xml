<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño premium 1024×600: menú lateral de vidrio, Inicio, Tablero y Bienvenida. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- ============ Menú lateral ============ -->
        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="92dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/side_logo"
                android:layout_width="56dp"
                android:layout_height="28dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="@string/logo"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/sidebar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/side_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/bg_dot"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/bt_on_status"
                android:textColor="@color/ok"
                android:textSize="10sp" />
        </LinearLayout>

        <Space
            android:layout_width="20dp"
            android:layout_height="match_parent" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- ===== Panel INICIO ===== -->
            <LinearLayout
                android:id="@+id/panel_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/home_greeting"
                        style="@style/Title" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glass_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/status_bt"
                            style="@style/StatusIcon"
                            android:contentDescription="@string/bluetooth"
                            android:src="@drawable/ic_bt" />

                        <ImageView
                            android:id="@+id/status_wifi"
                            style="@style/StatusIcon"
                            android:contentDescription="@string/wifi"
                            android:src="@drawable/ic_wifi" />

                        <ImageView
                            android:id="@+id/status_gps"
                            style="@style/StatusIcon"
                            android:contentDescription="@string/lbl_gps_speed"
                            android:src="@drawable/ic_pin" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- Reloj, velocidad y Android Auto -->
                    <LinearLayout
                        android:layout_width="360dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="4dp">

                            <TextView
                                android:id="@+id/clock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-thin"
                                android:fontFeatureSettings="tnum"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.03"
                                android:maxLines="1"
                                android:textColor="@color/clock"
                                android:textSize="128sp" />

                            <LinearLayout
                                android:id="@+id/speed_row"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:stateListAnimator="@animator/press">

                                <TextView
                                    android:id="@+id/home_speed"
                                    style="@style/Value"
                                    android:textSize="30sp" />

                                <TextView
                                    android:id="@+id/home_speed_unit"
                                    style="@style/Unit"
                                    android:text="@string/unit_kmh"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/home_speed_sub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:textColor="@color/text2"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/auto_button"
                            android:layout_width="match_parent"
                            android:layout_height="108dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="22dp"
                            android:paddingEnd="22dp"
                            android:stateListAnimator="@animator/press">

                            <FrameLayout
                                android:id="@+id/aa_chip"
                                android:layout_width="60dp"
                                android:layout_height="60dp">

                                <ImageView
                                    android:id="@+id/aa_icon"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_car" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="18dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/aa_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/auto_title"
                                    android:textSize="23sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/auto_sub"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/aa_arrow"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_arrow" />
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="20dp"
                        android:layout_height="match_parent" />

                    <!-- Reproductor -->
                    <LinearLayout
                        android:id="@+id/music_card"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass"
                        android:orientation="vertical"
                        android:paddingStart="26dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="26dp"
                        android:paddingBottom="22dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Label"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/lbl_playing" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_glass_pill"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp">

                                <View
                                    android:id="@+id/source_dot"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_dot" />

                                <TextView
                                    android:id="@+id/source"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:textColor="@color/text2"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/cover_box"
                                android:layout_width="148dp"
                                android:layout_height="148dp"
                                android:background="@drawable/bg_cover_empty">

                                <ImageView
                                    android:id="@+id/cover_icon"
                                    android:layout_width="54dp"
                                    android:layout_height="54dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_car" />

                                <ImageView
                                    android:id="@+id/art"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_cover_clip"
                                    android:contentDescription="@string/cover"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="22dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:textColor="@color/text"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/artist"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:textColor="@color/text2"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/media_access"
                                    android:layout_width="wrap_content"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="12dp"
                                    android:background="@drawable/bg_button"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:stateListAnimator="@animator/press"
                                    android:text="@string/media_access_button"
                                    android:textColor="@color/text"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/progress_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="invisible">

                            <ProgressBar
                                android:id="@+id/progress"
                                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="5dp"
                                android:max="1000"
                                android:progressDrawable="@drawable/progress_track" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">

                                <TextView
                                    android:id="@+id/pos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="@color/text2"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/dur"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="@color/text2"
                                    android:textSize="12sp" />
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/prev"
                                style="@style/RoundButton"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:background="@drawable/bg_glass_round"
                                android:contentDescription="@string/prev"
                                android:src="@drawable/ic_prev" />

                            <ImageButton
                                android:id="@+id/play"
                                android:layout_width="86dp"
                                android:layout_height="86dp"
                                android:layout_marginStart="30dp"
                                android:layout_marginEnd="30dp"
                                android:background="@drawable/bg_circle_light"
                                android:contentDescription="@string/play_pause"
                                android:scaleType="center"
                                android:src="@drawable/ic_play"
                                android:stateListAnimator="@animator/press"
                                android:tint="@color/play_icon" />

                            <ImageButton
                                android:id="@+id/next"
                                style="@style/RoundButton"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:background="@drawable/bg_glass_round"
                                android:contentDescription="@string/next"
                                android:src="@drawable/ic_next" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quick"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- ===== Panel TABLERO ===== -->
            <LinearLayout
                android:id="@+id/panel_board"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Title"
                        android:text="@string/nav_board" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/board_sub"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/gps_state"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_glass_pill"
                        android:drawableStart="@drawable/bg_dot"
                        android:drawablePadding="9dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/text2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/board_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_glass_pill"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="@color/text"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="470dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glass"
                        android:padding="12dp">

                        <app.autolauncher.GaugeView
                            android:id="@+id/gauge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/lbl_gps_speed" />
                    </FrameLayout>

                    <Space
                        android:layout_width="20dp"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Viaje actual -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass"
                            android:orientation="vertical"
                            android:paddingStart="26dp"
                            android:paddingTop="22dp"
                            android:paddingEnd="22dp"
                            android:paddingBottom="22dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/Label"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:text="@string/lbl_trip" />

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_chip_car">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_route"
                                        android:tint="@color/chip_icon" />
                                </FrameLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/trip_dist"
                                    style="@style/Value"
                                    android:fontFamily="sans-serif-thin"
                                    android:letterSpacing="-0.02"
                                    android:textColor="@color/clock"
                                    android:textSize="72sp" />

                                <TextView
                                    style="@style/Unit"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/unit_km"
                                    android:textSize="20sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/trip_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/text2"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <!-- Promedio, máxima y altitud -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="124dp"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_tile"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    style="@style/Label"
                                    android:text="@string/lbl_avg" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="true"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/trip_avg"
                                        style="@style/Value" />

                                    <TextView
                                        style="@style/Unit"
                                        android:text="@string/unit_kmh" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_tile"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    style="@style/Label"
                                    android:drawableStart="@drawable/bg_max_bar"
                                    android:drawablePadding="7dp"
                                    android:gravity="center_vertical"
                                    android:text="@string/lbl_max" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="true"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/trip_max"
                                        style="@style/Value" />

                                    <TextView
                                        style="@style/Unit"
                                        android:text="@string/unit_kmh" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_tile"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    style="@style/Label"
                                    android:text="@string/lbl_alt" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="true"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/trip_alt"
                                        style="@style/Value" />

                                    <TextView
                                        style="@style/Unit"
                                        android:text="@string/unit_m" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/gps_grant"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="12dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_button"
                                android:gravity="center"
                                android:stateListAnimator="@animator/press"
                                android:text="@string/gps_grant"
                                android:textColor="@color/text"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/trip_reset"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_button"
                                android:drawableStart="@drawable/ic_refresh"
                                android:drawablePadding="10dp"
                                android:drawableTint="@color/text"
                                android:gravity="center"
                                android:paddingStart="24dp"
                                android:paddingEnd="24dp"
                                android:stateListAnimator="@animator/press"
                                android:text="@string/trip_reset"
                                android:textColor="@color/text"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ============ Bienvenida: fija hasta tocar la pantalla o "Inicio" ============ -->
    <FrameLayout
        android:id="@+id/welcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_welcome"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="112dp"
            android:layout_marginEnd="112dp"
            android:background="@drawable/bg_horizon" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.6" />

            <FrameLayout
                android:id="@+id/welcome_logo_box"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/bg_glass"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/welcome_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/logo"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/welcome_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-thin"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:textColor="@color/clock"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/welcome_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text2"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/welcome_bt"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_pill"
                    android:drawableStart="@drawable/bg_dot"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/welcome_gps"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_glass_pill"
                    android:drawableStart="@drawable/bg_dot"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/welcome_start"
                android:layout_width="wrap_content"
                android:layout_height="68dp"
                android:drawableEnd="@drawable/ic_arrow"
                android:drawablePadding="14dp"
                android:gravity="center"
                android:minWidth="180dp"
                android:paddingStart="34dp"
                android:paddingEnd="30dp"
                android:stateListAnimator="@animator/press"
                android:text="@string/welcome_start"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="40dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/welcome_tap"
                android:textColor="@color/text3"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
