<?xml version="1.0" encoding="utf-8"?>
<!-- Respuesta al tocar: se encoge al 96 % y regresa. Respeta la escala de animaciones del sistema. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.96" android:duration="90" android:interpolator="@android:interpolator/decelerate_quad" android:valueType="floatType"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.96" android:duration="90" android:interpolator="@android:interpolator/decelerate_quad" android:valueType="floatType"/>
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="160" android:interpolator="@android:interpolator/decelerate_quad" android:valueType="floatType"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="160" android:interpolator="@android:interpolator/decelerate_quad" android:valueType="floatType"/>
        </set>
    </item>
</selector>
